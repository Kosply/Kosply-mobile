# Copy this file to .env, then flutter run. Hot reload does not reload it.
# A phone on the same LAN uses the computer's address, for example
# http://192.168.1.10:3500. The Android emulator uses http://10.0.2.2:3500.
KOSPLY_API_URL=http://10.0.2.2:3500

# Web OAuth client id passed to Google Sign-In as serverClientId.
# This is not the Android client id, and it is not a client secret.
GOOGLE_SERVER_CLIENT_ID=
